# 统一用 LF 存仓，避免 Windows 工作区把整文件都标成改动
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.spec  text eol=lf

# 二进制：不参与换行转换
*.exe    binary
*.ico    binary
*.png    binary
*.webp   binary
*.woff2  binary
*.pyc    binary
